          type: code
          content: >-
            print ("ingrese 5 numeros enteros:")

            lista=[]

            suma=0

            for i in range (5):
                lista.append(int(input("ingrese un numero: ")))
                suma= suma + lista[i]
            print ("la lista es: ",lista)

            print ("la suma de los numeros es: ",suma)

            promedio= suma/5

            print ("el promedio de los numeros es: ",promedio)
